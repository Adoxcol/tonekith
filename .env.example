# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43187
PORT=43187

# Database
DATABASE_URL=postgresql://tone:tone@127.0.0.1:5432/tone_community

# Better Auth
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-32chars
BETTER_AUTH_URL=http://127.0.0.1:43187

# Storage: "local" | "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# S3-compatible (MinIO / R2 / AWS) — used when STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=tone-community
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://127.0.0.1:9000/tone-community
